# Server Port
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/wedding_rsvp?retryWrites=true&w=majority
MONGODB_URI=

# Admin Dashboard Password Hash (generated automatically by npm run setup, or bcrypt hash)
ADMIN_PASSWORD_HASH=

# JWT Secret for authenticating admin sessions (generated automatically by npm run setup)
JWT_SECRET=

# Allowed Frontend Origins (comma-separated list of URLs allowed to call the API)
# Use * to allow all frontends, or specific URLs: http://localhost:3000,https://mywedding.vercel.app
ALLOWED_ORIGINS=*

